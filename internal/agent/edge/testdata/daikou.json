{
  "admin": {
    "listen": "unix//run/edge/admin.sock"
  },
  "apps": {
    "http": {
      "servers": {
        "edge": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "stream_close_delay": "1h",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:3000"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "daikou.online"
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "response": {
                            "deferred": true,
                            "set": {
                              "Cache-Control": [
                                "private, no-store"
                              ]
                            }
                          }
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/evidence/*"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "zstd",
                            "gzip"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Forwarded-For": [
                                  "{http.request.header.CF-Connecting-IP}"
                                ]
                              }
                            }
                          },
                          "stream_close_delay": "1h",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8788"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "header": {
                            "Cf-Connecting-Ip": [
                              "*"
                            ]
                          },
                          "remote_ip": {
                            "ranges": [
                              "103.21.244.0/22",
                              "103.22.200.0/22",
                              "103.31.4.0/22",
                              "104.16.0.0/13",
                              "104.24.0.0/14",
                              "108.162.192.0/18",
                              "131.0.72.0/22",
                              "141.101.64.0/18",
                              "162.158.0.0/15",
                              "172.64.0.0/13",
                              "173.245.48.0/20",
                              "188.114.96.0/20",
                              "190.93.240.0/20",
                              "197.234.240.0/22",
                              "198.41.128.0/17",
                              "2400:cb00::/32",
                              "2405:8100::/32",
                              "2405:b500::/32",
                              "2606:4700::/32",
                              "2803:f800::/32",
                              "2a06:98c0::/29",
                              "2c0f:f248::/32"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "delete": [
                                "Cf-Connecting-Ip",
                                "True-Client-Ip",
                                "X-Real-Ip"
                              ]
                            }
                          },
                          "stream_close_delay": "1h",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8788"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "defectdrainer.com"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "email": "ops@example.com",
                "module": "acme"
              }
            ],
            "subjects": [
              "daikou.online",
              "defectdrainer.com"
            ]
          }
        ]
      }
    }
  }
}
