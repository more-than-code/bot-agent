# Host policy for bot-agent-runner.
# Install as /etc/bot-agent/runner.toml, owner root:root, mode 0644.
# Leave enabled false until the directories and accounts below are reviewed.
# The agent reads this file only at startup. Restart bot-agent after a change.

enabled = false
run_as = ["joe"]
dirs = ["/home/joe/workspace"]
exec_allow = ["/usr/bin/node", "/usr/bin/npm", "/usr/bin/pnpm"]
allow_shell = false
max_programs = 20
# Programs run only for the project slugs listed here (from v0.2.8), and so do
# images. With programs on and no projects, install.sh check/install/upgrade
# --runner refuse the file.
# projects = ["your-project"]

# Image containers. Uncommenting these gives the helper the Docker socket's
# power: container access equals root on the host. Leave them commented until
# the patterns and project slugs are reviewed. images = [] turns containers off.
# images = ["ghcr.io/joe-and-his-friends/*"]
# max_containers = 20
# allow_public_ports = false

# Shared networks (agent 0.2.9 and later; an older agent rejects these keys
# and turns programs and images off, so upgrade the agent first). A shared
# network lets the listed projects' containers reach each other by container
# name <project>-<entry>. The subnet is fixed: a private IPv4 range (10/8,
# 172.16/12 or 192.168/16), prefix /16 to /28, not overlapping the host's
# routes or Docker's pools. Each member slug must also be in projects.
# shared_networks = ["dd=10.200.10.0/24"]
# shared_network_projects = ["dd:daikou", "dd:defect-drainer"]

# Per-host edge (agent 0.2.11 and later; an older agent rejects this key and
# turns programs and images off, so upgrade the agent first). Lets the host's
# org admins turn on a Deploybot-managed Caddy container, deploybot-edge, that
# binds ports 80 and 443 in the host network and serves the projects' routes.
# Needs Docker, and 80 and 443 free and reachable from the internet.
# edge = true

# Console-managed policy (agent 0.2.15 and later; an older agent rejects this
# key and turns programs and images off, so upgrade the agent first). Lets the
# host's org owners and admins change edge, images and projects from the
# Deploybot console's host Policy tab. Every other key stays yours: the
# console cannot change run_as, dirs, exec_allow, allow_shell, shared
# networks, host_files, agent_upgrade or this key. An apply keeps
# runner.toml.prev, restarts bot-agent and puts the previous file back when
# the agent does not reconnect within 90 seconds. Image patterns are shown to
# org owners and admins while this is on.
# console_policy = true

# v1.24 (bot-agent 0.2.16): the cgroup namespace for containers. Leave it
# out (private). Set "host" only on a host whose kernel has no cgroup
# namespaces (OpenVZ, some LXC), where every container start fails
# otherwise; a container can then read the host's cgroup tree. The console
# cannot change it. Upgrade the agent before adding the key.
# container_cgroupns = "host"
